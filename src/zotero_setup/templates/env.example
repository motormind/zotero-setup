# Copy to .env and fill in. NEVER commit .env.
# Create a key at https://www.zotero.org/settings/keys (only the permissions you need)
ZOTERO_API_KEY=your_api_key_here

# Optional - override values from .zotero.toml
# ZOTERO_LIBRARY_TYPE=group
# ZOTERO_LIBRARY_ID=000000
# ZOTERO_COLLECTION=

# Optional: read from the local Zotero desktop app instead of the Web API
# ZOTERO_LOCAL=true

# Optional: contact address for the Crossref "polite pool" (only if you want to)
# CROSSREF_MAILTO=
